    {
      "type": "featureGridSection",
      "title": "O kit de ferramentas IA definitivo para design profissional de layout de revista",
      "features": [
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c2b2d0e9e17df4ca706d030cf8d1d6256b43b3f15a9f846701a78f6177bde6b0.png", "title": "Sistemas de grade inteligentes", "description": "O agente da Lovart seleciona e adapta automaticamente grades multi-colunas com base no seu tipo de conteúdo — de layouts de entrevista de 2 colunas a relatórios densos de 4 colunas. O sistema garante espaçamento adequado entre colunas, margens consistentes e ritmo visual equilibrado em cada spread. Nenhuma configuração manual de grade necessária." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/f30b2cdc84a69127e78f8259f020b870d701284b136cf317b5191210e2804ab3.png", "title": "Motor tipográfico editorial", "description": "Aplique tipografia editorial profissional com o Text Edit — modifique títulos, subtítulos, corpo do texto e legendas preservando a hierarquia de fontes, entrelinha, kerning e consistência de estilo. Diferente de ferramentas IA genéricas, a Lovart renderiza texto nítido com qualidade de publicação em cada nível da hierarquia tipográfica." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c0a7bbac9b50aa6e722a10968eb84425268fc05144d69222af892acb9b1d5932.png", "title": "Motor de mockups de spreads impressos", "description": "Visualize seu layout de revista em contextos realistas de publicação. Use o Smart Mockup para ver seu spread como revista aberta, em exposição na banca, sobre uma mesa de centro ou como edição digital em tablets. O motor processa automaticamente a curvatura da página, iluminação e perspectiva para apresentações fotorrealistas." },
