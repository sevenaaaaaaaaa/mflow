<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mflow.daily-pipeline</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__MFLOW_ROOT__/dev/automation/run-daily-pipeline.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__MFLOW_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__MFLOW_LOCAL_DEV_ROOT__/Logs/com.mflow.daily-pipeline.out.log</string>
  <key>StandardErrorPath</key>
  <string>__MFLOW_LOCAL_DEV_ROOT__/Logs/com.mflow.daily-pipeline.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
