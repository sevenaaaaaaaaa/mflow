  "section_fr": [
    {
      "type": "centeredInputSection",
      "title": "Créateur de mise en page de magazine IA — Concevez des doubles pages professionnelles avec l'agent créatif IA de Lovart",
      "description": "Arrêtez de vous battre avec les grilles d'InDesign et d'attendre des designers éditoriaux. L'agent créatif IA de Lovart transforme la description de votre contenu en mises en page de magazine professionnelles en quelques minutes. Propulsé par le moteur de raisonnement MCoT, notre agent pense comme un directeur artistique — il analyse votre type de contenu, le style de publication et les attentes des lecteurs avant de générer des mises en page multi-colonnes, le placement d'images et les systèmes typographiques. Des éditoriaux de mode aux rapports d'entreprise, des reportages de voyage aux doubles pages lifestyle, Lovart livre des mises en page prêtes pour l'impression dignes de publications professionnelles. Commencez à créer avec des crédits quotidiens gratuits.",
      "input_placeholder": "Décrivez votre double page de magazine — incluez le type de contenu, le style de publication, le thème de l'article et la direction visuelle",
      "system_prompt": "Vous êtes un directeur artistique senior et spécialiste des mises en page de magazine IA chez Lovart. À l'aide du moteur MCoT, analysez : 1) Le type de publication (mode, business, voyage, lifestyle) et ses conventions éditoriales, 2) La hiérarchie du contenu — titre, chapeau, corps de texte, citations, légendes, 3) La démographie des lecteurs cibles et leur comportement de lecture, 4) Le système visuel — structure des colonnes, ratio image-texte, association typographique, stratégie d'espaces blancs — qui maximise la lisibilité et l'impact visuel. Orchestrez le pipeline de design agentique de Lovart : sélectionnez la grille optimale dans ChatCanvas, générez des images éditoriales avec Nano Banana Pro, appliquez une typographie multi-colonnes précise et livrez une double page complète. Exigences de l'utilisateur : $input$",
      "button_text": "Créer ma mise en page",
      "tip": "Conseil pro : incluez le type de publication, le thème de l'article, le nombre de colonnes, le style visuel préféré et le format souhaité — print ou numérique",
      "suggestion": [
        { "value": "Créez un éditorial de mode audacieux avec des photos pleine page, une typographie de titre dramatique, une mise en page en colonnes asymétriques et des citations élégantes — pour un magazine de mode de luxe", "label": "Éditorial Mode" },
        { "value": "Concevez un rapport d'entreprise épuré avec des visualisations de données, une barre latérale de résumé exécutif, une typographie professionnelle avec empattements et une grille multi-colonnes structurée — pour une publication business", "label": "Rapport d'Entreprise" },
        { "value": "Créez un reportage de voyage immersif avec des photos panoramiques, des titres de destination manuscrits, une carte intégrée et des colonnes narratives fluides — pour un magazine de voyage", "label": "Reportage Voyage" },
        { "value": "Concevez un article lifestyle moderne avec un ratio image-texte équilibré, une hiérarchie de sous-titres engageante, des barres latérales de recettes ou tutoriels et une typographie sans empattement épurée — pour une publication lifestyle", "label": "Article Lifestyle" }
      ]
