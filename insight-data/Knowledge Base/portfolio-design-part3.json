        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/a605b61b07e767af7c70d858c27756f7e15f56b99a389980fba298cba1b8ffa7.png", "title": "Exportação em alta resolução 8K", "description": "Exporte seu portfólio com resolução de até 8K nos formatos PNG, JPG, SVG, PSD em camadas ou PDF interativo. Perfeito para impressão de alta qualidade, envios digitais, uploads para sites e apresentações para clientes. Cada exportação mantém a qualidade visual esperada de um portfólio criativo profissional." },
