        {
          "_key": "22d6qbyi",
          "_type": "span",
          "marks": [],
          "text": ": “Create a 8-second promotional video for a new smartwatch highlighting its features: fitness tracking, long battery life, and sleek design. Add upbeat background music and a voiceover that explains these features.”"
        }
      ],
      "level": 1,
      "listItem": "bullet",
