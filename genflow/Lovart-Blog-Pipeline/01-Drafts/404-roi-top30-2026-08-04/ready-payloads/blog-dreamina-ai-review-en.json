      "children": [
        {
          "_key": "jalcmd00",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Templates & presets —"
        },
        {
          "_key": "4mfql1vl",
          "_type": "span",
          "marks": [],
          "text": " Ready-made templates for promos, intros, and social shorts. They’re helpful scaffolds — swap copy, adjust timing, and the template preserves the general rhythm. Why it matters: gets a presentable draft quickly for client review."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "dhe8doci",
      "_type": "block",
      "children": [
        {
          "_key": "q4f7kv01",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Editing & refinement —"
        },
        {
          "_key": "gch6759q",
          "_type": "span",
          "marks": [],
          "text": " Simple timeline edits, replaceable assets, and shot-level adjustments. Not a full NLE but enough to tighten cuts and swap text/audio. Why it matters: most ideation wounds are fixed here before sending to an editor."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "skyn2ep5",
