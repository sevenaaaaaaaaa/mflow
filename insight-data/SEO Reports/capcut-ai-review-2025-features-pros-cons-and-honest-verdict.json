      "_type": "block",
      "children": [
        {
          "_key": "eljl2dua",
          "_type": "span",
          "marks": [],
          "text": "You can describe a scene, and CapCut generates footage that can be edited alongside real footage. The quality varies—sometimes impressive, sometimes obviously AI-generated—but the integration with the broader editing suite is seamless."
        }
      ],
      "markDefs": [],
      "style": "normal"
