      "children": [
        {
          "_key": "5r6ndepd",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Asset library & AI suggestions —"
        },
        {
          "_key": "nhn6o2g4",
          "_type": "span",
          "marks": [],
          "text": " Built-in stock clips, music suggestions, and suggested framings/shot lists help fill gaps. The system suggests image styles or moods based on prompts. Why it matters: cuts the time spent hunting for filler content."
        }
      ],
      "level": 1,
      "listItem": "bullet",
