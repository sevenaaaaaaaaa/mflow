    {
      "type": "faq",
      "title": "Marketer FAQ",
      "items": [
        {
          "question": "Who is this landing page for?",
          "answer": "Digital marketing managers and campaign leads who need coordinated creative across paid, social, and email — not a single-purpose image generator."
        },
        {
          "question": "What do I get from one brief?",
          "answer": "A campaign set that can include ad concepts, social frames, email headers, and short video directions, then edited winners for launch."
        },
        {
          "question": "Can my team edit after stakeholder feedback?",
          "answer": "Yes. ChatCanvas keeps context while Touch Edit and Text Edit handle local fixes without restarting the whole campaign."
        },
        {
          "question": "How is this different from the e-commerce landing page?",
          "answer": "This page is campaign-funnel oriented for marketers. The e-commerce page focuses on SKU kits for store and catalog operators."
        },
        {
          "question": "Does Lovart replace my design team?",
          "answer": "No. It gives marketing managers a faster first draft and revision loop so design partners spend time on judgment, not blank-page production."
        },
        {
          "question": "Can I keep brand rules attached?",
          "answer": "Yes. Use Brand Kit so palette, logo, and type stay present while you generate and extend variants."
        }
      ]
