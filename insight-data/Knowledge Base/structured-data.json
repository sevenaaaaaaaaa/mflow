  "faq_pricing": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do credits work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Credits are used to process your request and generate the final output, with usage depending on what you choose and how complex the task is. More complex tasks require more credits."
        }
      },
      {
        "@type": "Question",
        "name": "Will credits expire?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Monthly Plan Credits are valid for the duration of your current billing cycle and automatically reset next billing date. Annual Plan credits are distributed monthly and valid within that month's cycle."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between Monthly and Annual plans?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Annual plans offer a discount compared to monthly billing. Both receive monthly credit allocations based on the plan tier."
        }
      },
      {
        "@type": "Question",
        "name": "Can I upgrade or downgrade my plan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you can upgrade or downgrade your plan at any time. Changes take effect at the start of your next billing cycle."
        }
      }
    ]
  },
