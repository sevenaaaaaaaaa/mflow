        {
          "_key": "s126aser",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "AI image/video —"
        },
        {
          "_key": "w1aclb35",
          "_type": "span",
          "marks": [],
          "text": " Prompts are parsed into scene segments and a basic pacing structure. Dreamina leans into short, social-friendly formats (e.g., 9:16 reels) and produces quick storyboards that you can refine. Why it matters: speeds concept-to-rough-cut."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
