        {
          "_key": "df29xtfa",
          "_type": "span",
          "marks": [],
          "text": "Haiper AI has built its foundation on a proprietary video generation model optimized for consistency and visual quality. Unlike some competitors that prioritize quantity over quality, Haiper focuses on delivering fewer but more refined outputs."
        }
      ],
      "markDefs": [],
      "style": "normal"
