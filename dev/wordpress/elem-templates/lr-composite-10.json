{"version": "3.35.7", "data": [{"id": "bc61886", "elType": "container", "settings": {"content_width": "full", "gap": "no", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "1ad0128", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"lr dark\"><div class=\"lr dark\"><div <div id=\"internal-section-9\" class=\"scroll-mt-14\"><div class=\"contents\" data-lp-section=\"cluster-block-dense\"><div class=\"mx-auto flex w-full max-w-[1400px] items-center justify-center px-5 py-[60px] pt-[80px] pb-[40px] md:px-[32px] md:pt-[100px] lg:px-[40px] xl:px-[60px]\"><div class=\"flex w-full flex-col\"><div class=\"relative w-full bg-transparent pt-[80px] pb-0 md:pt-[120px] pt-0 pb-10 md:pt-0 md:pb-14\"><div class=\"mx-auto flex w-full max-w-[1480px] flex-col items-center gap-5 px-5 sm:px-[60px] md:gap-[26px] md:px-[32px]\"><div class=\"flex flex-col items-center gap-[9px] md:gap-[10px]\"><h2 class=\"font-serif-display text-text-default text-center text-[30px] leading-[1.25] text-balance whitespace-pre-wrap md:text-[42px] xl:text-[56px]\">Where Shopify funnels leak creative performance</h2></div><p class=\"text-text-secondary w-full max-w-[600px] text-center font-sans text-[14px] leading-[1.4] text-balance whitespace-pre-wrap md:text-[16px] xl:text-[18px]\">Dense cards frame the operational problems ecommerce teams recognize immediately.</p></div></div><div class=\"grid grid-cols-1 gap-[48px] md:grid-cols-2 md:gap-x-6 md:gap-y-10 lg:grid-cols-3 lg:gap-x-8\"><div class=\"flex flex-col items-start text-left\"><div class=\"bg-bg-overlay-l2 rounded-lo-radius-12 mb-5 flex h-[60px] w-[60px] shrink-0 items-center justify-center md:mb-6\"><span class=\"text-icon-default flex size-6 items-center justify-center [&amp;&gt;svg]:size-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\"