      "_type": "block",
      "children": [
        {
          "_key": "kis9m3cd",
          "_type": "span",
          "marks": [],
          "text": "The model handles complex scenes reasonably well, including multiple characters, natural movements, and varied lighting conditions. While not perfect—hands and text remain challenging for AI—the overall visual coherence stands out in its class."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
