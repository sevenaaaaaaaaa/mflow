          "marks": [
            "strong"
          ],
          "text": "Prompt:"
        },
        {
          "_key": "j7213vrg",
          "_type": "span",
          "marks": [],
          "text": " Minimalist product photo of matte-black ceramic mug on white seamless background, top-left softbox, drop shadow, 45° angle, 4k detail, studio retouching\n"
        },
        {
          "_key": "os5t5da4",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Settings:"
        },
        {
          "_key": "lblnxkqz",
          "_type": "span",
          "marks": [],
          "text": " Product / mockup preset, aspect "
        },
        {
          "_key": "8gizjilq",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "1:1"
        },
        {
          "_key": "kc6h7wgp",
          "_type": "span",
          "marks": [],
          "text": " (square) or "
        },
        {
          "_key": "3hqxi0o3",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "4:5"
        },
        {
          "_key": "8jqwnu5u",
          "_type": "span",
          "marks": [],
          "text": ". "
        },
        {
          "_key": "i8x0anu8",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Observed outcome:"
        },
        {
          "_key": "z62fxwk9",
          "_type": "span",
          "marks": [],
          "text": " Very sharp object edges and realistic shadows — ideal for thumbnails. Sometimes the handle or reflected highlights need one quick in-app touch-up. Upscaling after generation gives print-quality results.\n"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
