    {
      "type": "featureGridSection",
      "title": "Das ultimative KI-Toolkit für professionelles Portfolio-Design",
      "features": [
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c2b2d0e9e17df4ca706d030cf8d1d6256b43b3f15a9f846701a78f6177bde6b0.png", "title": "Intelligente Galerie-Layouts", "description": "Der Agent von Lovart wählt automatisch das optimale Bildpräsentationsformat für jedes Projekt aus — randlose Hero-Bilder, rasterbasierte Galerien, Side-by-Side-Vergleiche oder Prozessdokumentationssequenzen. Das System gewährleistet einen angemessenen visuellen Rhythmus, ausgewogene Weißräume und eine überzeugende Bildhierarchie in Ihrem gesamten Portfolio." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/f30b2cdc84a69127e78f8259f020b870d701284b136cf317b5191210e2804ab3.png", "title": "Professionelles Typografie-System", "description": "Wenden Sie polierte, professionelle Typografie für Projekttitel, Beschreibungen, Case-Study-Erzählungen und Ihre Biografie mit Text Edit an. Anders als generische KI-Tools rendert Lovart gestochen scharfen, lesbaren Text, der eine perfekte Hierarchie beibehält — von fetten Projektüberschriften bis zu verfeinertem Fließtext — auf jeder Seite Ihres Portfolios." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c0a7bbac9b50aa6e722a10968eb84425268fc05144d69222af892acb9b1d5932.png", "title": "Portfolio-Buch-Mockup-Engine", "description": "Sehen Sie Ihr Portfolio sofort in realistischen Präsentationskontexten. Verwenden Sie Smart Mockup, um Ihre Arbeit als gedrucktes Portfolio-Buch, auf einem Tablet-Bildschirm, als auf einem Laptop geöffnete PDF oder in einer Vorstellungsgesprächs-Situation zu betrachten. Die Engine verarbeitet Beleuchtung, Perspektive und Oberflächentexturen automatisch für fotorealistische, kundenfertige Präsentationen." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/09928fa343e91c59008a2e00c6528969f41fb1559d444c633e46c9da63d11dd6.png", "title": "Persönliche Markenkonsistenz", "description": "Angetrieben von Nano Banana Pro und ChatCanvas stellt Lovart sicher, dass jede Seite Ihres Portfolios konsistente Typografie, Farbpalette, Layout-Rhythmus und visuelle Identität teilt. Definieren Sie Ihre persönliche Marke einmal, und der Agent hält sie auf jeder Projektseite aufrecht — und schafft eine zusammenhängende berufliche Erzählung, die Arbeitgeber und Kunden beeindruckt." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/a605b61b07e767af7c70d858c27756f7e15f56b99a389980fba298cba1b8ffa7.png", "title": "Hochauflösender 8K-Export", "description": "Exportieren Sie Ihr Portfolio mit bis zu 8K-Auflösung in PNG, JPG, SVG, Ebenen-PSD oder interaktiven PDF-Formaten. Perfekt für hochwertigen Druck, digitale Einreichungen, Website-Uploads und Kundenpräsentationen. Jeder Export bewahrt die visuelle Qualität, die von einem professionellen Kreativ-Portfolio erwartet wird." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c7f26357d97de99927ed994806f34aa7110314fc4ac8204733bb8339825cb166.png", "title": "Multiformat-Präsentations-Engine", "description": "Einmal gestalten, überall präsentieren. Nach der Erstellung Ihres Master-Portfolios generiert Lovart optimierte Varianten: gedrucktes Portfolio-Buch (gegenüberliegende Seiten), Tablet-Präsentation (Querformat), PDF-Dokument (Letter/A4), webfähige Galerie und Social-Media-Vorschauen — unter Beibehaltung Ihres professionellen Design-Systems. Seien Sie bereit für jedes Vorstellungsgespräch und jedes Kundentreffen." }
      ]
