          "marks": [],
          "text": "優れている点 — Freepik AIが光る場面"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "39a8ncmx",
      "_type": "bodyImage",
      "alt": "img",
