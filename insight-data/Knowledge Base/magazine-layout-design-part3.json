      "features": [
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c2b2d0e9e17df4ca706d030cf8d1d6256b43b3f15a9f846701a78f6177bde6b0.png", "title": "Systèmes de grille intelligents", "description": "L'agent de Lovart sélectionne et adapte automatiquement des grilles multi-colonnes selon votre type de contenu — des mises en page d'interview à 2 colonnes aux rapports denses à 4 colonnes. Le système garantit des gouttières appropriées, des marges cohérentes et un rythme visuel équilibré sur chaque double page. Aucune configuration manuelle de grille requise." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/f30b2cdc84a69127e78f8259f020b870d701284b136cf317b5191210e2804ab3.png", "title": "Moteur typographique éditorial", "description": "Appliquez une typographie éditoriale professionnelle avec Text Edit — modifiez les titres, sous-titres, corps de texte et légendes tout en préservant la hiérarchie des polices, l'interlignage, le crénage et la cohérence stylistique. Contrairement aux outils IA génériques, Lovart restitue un texte net de qualité publication à chaque niveau de la hiérarchie typographique." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c0a7bbac9b50aa6e722a10968eb84425268fc05144d69222af892acb9b1d5932.png", "title": "Moteur de maquettes de doubles pages", "description": "Prévisualisez votre mise en page de magazine dans des contextes de publication réalistes. Utilisez Smart Mockup pour voir votre double page comme un magazine ouvert, dans un présentoir de kiosque, sur une table basse ou en édition numérique sur tablette. Le moteur gère automatiquement le gondolement des pages, l'éclairage et la perspective pour des présentations photoréalistes." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/09928fa343e91c59008a2e00c6528969f41fb1559d444c633e46c9da63d11dd6.png", "title": "Cohérence de marque de publication", "description": "Propulsé par Nano Banana Pro et ChatCanvas, Lovart garantit que chaque double page de votre publication conserve une typographie, une palette de couleurs, des systèmes de marges et une identité visuelle cohérentes. Définissez votre charte graphique de publication une fois, et l'agent l'applique automatiquement à chaque numéro — de la couverture à la dernière page." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/a605b61b07e767af7c70d858c27756f7e15f56b99a389980fba298cba1b8ffa7.png", "title": "Export 8K prêt pour l'impression", "description": "Exportez vos doubles pages jusqu'à une résolution 8K dans des formats professionnels avec des zones de fond perdu correctes (standard 3 mm), des profils CMJN, des traits de coupe et la conformité PDF/X standard. Prêt à être soumis directement aux imprimeurs commerciaux, aux presses offset et aux plateformes de publication numérique." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c7f26357d97de99927ed994806f34aa7110314fc4ac8204733bb8339825cb166.png", "title": "Moteur de publication multi-format", "description": "Concevez une fois, publiez partout. Après avoir créé votre double page maîtresse, Lovart génère des variantes optimisées : double page imprimée (pages en vis-à-vis avec fond perdu), édition numérique (page unique optimisée), format paysage tablette, vue article vertical adaptée au mobile et aperçus pour les réseaux sociaux — tout en préservant l'intégrité du design éditorial." }
