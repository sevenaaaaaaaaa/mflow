// All unique macro fields across all platforms (for CSV template)
const ALL_MACRO_FIELDS = [...new Set(PLATFORMS.flatMap(p => p.macros.map(m => m.field)))].sort();
const MACRO_FIELD_DEFAULTS = {};
PLATFORMS.forEach(p => {
  p.macros.forEach(m => {
    if (!MACRO_FIELD_DEFAULTS[m.field]) MACRO_FIELD_DEFAULTS[m.field] = {};
    MACRO_FIELD_DEFAULTS[m.field][p.code] = m.template;
  });
});

// ====== 33 Modules based el/sec presets ======
const EL_PRESETS = [
  'cta_primary','cta_secondary','cta_primary_bottom','cta_secondary_bottom',
  'nav_signup','nav_login','nav_trial','nav_pricing',
  'card_link','tab_cta','tool_card','blog_card','price_card','pricing_cta',
  'feature_cta','showcase_cta','portrait_cta','prompt_btn','marquee_cta',
  'hero_btn','mosaic_tile','journey_card','canvas_link','media_click',
  'link_inline','link_footer','stats_link','proof_link','logo_click',
  'comparison_link','before_link','after_link',
];
const SEC_PRESETS = [
  'hero-split','hero-cinematic','hero-journey','hero-mosaic','hero-gallery',
  'bento-2','bento-4','bento-6','feature-grid','cluster-block-dense',
  'capability-tabs','tool-grid','blog-grid','feature-detail','canvas-wall',
  'portrait-grid-3','portrait-grid-4','showcase-stacked','showcase-horizontal',
  'prompt-launcher','logo-loop','media-marquee',
  'cta-default','cta-bottom',
  'workflow-horizontal','workflow-vertical',
  'comparison-table','comparison-before-after',
  'testimonial','review-grid-3col','review-grid-4col',
  'stats','proof-block','pricing-block','faq',
];

// ====== STATE ======
let selectedPlatform = null;
let batchParsedRows = [];
let batchGeneratedURLs = [];

// ====== DOM refs ======
const $ = (s) => document.querySelector(s);
const $$ = (s) => document.querySelectorAll(s);

// ====== TOAST ======
function showToast(msg, type = '') {
  const t = $('#toast');
  t.textContent = msg;
  t.className = 'toast ' + type + ' show';
  clearTimeout(t._timeout);
  t._timeout = setTimeout(() => t.classList.remove('show'), 2500);
}

// ====== TABS ======
$$('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    $$('.tab').forEach(t => t.classList.remove('active'));
    $$('.tab-panel').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    const panel = document.getElementById('tab_' + tab.dataset.tab);
    if (panel) panel.classList.add('active');
  });
});

// ====== PLATFORM PICKER ======
function platformByName(name) {
  return PLATFORMS.find(p => p.name === name);
}

function renderPlatformDropdown(filter = '') {
  const q = filter.toLowerCase().trim();
  const filtered = PLATFORMS.filter(p => !q || p.name.toLowerCase().includes(q) || p.code.toLowerCase().includes(q) || p.source.toLowerCase().includes(q));
  const dd = $('#platform_dropdown');
  dd.innerHTML = filtered.length === 0
    ? '<div class="p-no-result">无匹配平台</div>'
    : filtered.map(p =>
      `<div class="platform-opt${selectedPlatform && selectedPlatform.code === p.code ? ' selected' : ''}">
        <span class="p-tag ${p.type}">${p.type}</span> ${p.name}
      </div>`).join('');
  dd.querySelectorAll('.platform-opt').forEach(div => {
    div.addEventListener('mousedown', e => {
      e.preventDefault();
      const p = platformByName(div.textContent.trim().replace(/^\w+\s+/, ''));
      if (p) selectPlatform(p);
    });
  });
}

function selectPlatform(p) {
  selectedPlatform = p;
  $('#platform_input').value = p.name;
  $('#platform_dropdown').classList.remove('show');
  $('#utm_source').value = p.source;
  renderMediumOptions(p);
  renderMacros(p);
  clearFieldError('platform');
}

$('#platform_input').addEventListener('focus', () => { renderPlatformDropdown($('#platform_input').value); $('#platform_dropdown').classList.add('show'); });
$('#platform_input').addEventListener('input', () => {
  const val = $('#platform_input').value.trim();
  renderPlatformDropdown(val);
  $('#platform_dropdown').classList.add('show');
  if (selectedPlatform && val !== selectedPlatform.name) {
    selectedPlatform = null;
    $('#utm_source').value = '';
    $('#utm_medium').innerHTML = '<option value="">— 请选择 —</option>';
    $('#macro_content').style.display = 'none';
    $('#macro_placeholder').style.display = '';
  }
});
$('#platform_input').addEventListener('keydown', e => { if (e.key === 'Escape') $('#platform_dropdown').classList.remove('show'); });
document.addEventListener('click', e => { if (!e.target.closest('.platform-picker')) $('#platform_dropdown').classList.remove('show'); });

// ====== MEDIUM ======
function renderMediumOptions(p) {
  $('#utm_medium').innerHTML = '<option value="">— 请选择 —</option>' +
    p.mediumOptions.map(m => `<option value="${m}">${MEDIUM_LABELS[m] || m}</option>`).join('');
}

// ====== MACROS (fixed: use div, not label; prevent default) ======
function renderMacros(p) {
  $('#macro_placeholder').style.display = 'none';
  $('#macro_content').style.display = '';
  const dM = p.macros.filter(m => m.default);
  const mM = p.macros.filter(m => !m.default);

  $('#default_macros').innerHTML = dM.map(m =>
    `<div class="macro-item checked">
      <input type="checkbox" data-field="${m.field}" data-template="${h(m.template)}" checked />
      ${m.field}<span class="macro-tmpl">${h(m.template)}</span>
    </div>`).join('');
  $('#more_macros_list').innerHTML = mM.map(m =>
    `<div class="macro-item">
      <input type="checkbox" data-field="${m.field}" data-template="${h(m.template)}" />
      ${m.field}<span class="macro-tmpl">${h(m.template)}</span>
    </div>`).join('');

  $('#toggle_more').classList.remove('open');
  $('#toggle_more').innerHTML = mM.length > 0
    ? `展开全部宏 (+${mM.length}) <span class="arrow-icon">▼</span>`
    : '展开全部宏 <span class="arrow-icon">▼</span>';
  $('#toggle_more').style.display = mM.length > 0 ? '' : 'none';
  $('#more_macros').classList.remove('show');

  // Bind click handlers on individual macro items (div, not label)
  document.querySelectorAll('#macro_content .macro-item').forEach(item => {
    item.addEventListener('click', function(e) {
      const cb = this.querySelector('input[type="checkbox"]');
      cb.checked = !cb.checked;
      this.classList.toggle('checked', cb.checked);
    });
  });
}

$('#toggle_more').addEventListener('click', () => {
  $('#toggle_more').classList.toggle('open');
  $('#more_macros').classList.toggle('show');
  const p = selectedPlatform;
  const mM = p ? p.macros.filter(m => !m.default) : [];
  $('#toggle_more').innerHTML = $('#toggle_more').classList.contains('open')
    ? `收起 <span class="arrow-icon">▼</span>`
    : `展开全部宏 (+${mM.length}) <span class="arrow-icon">▼</span>`;
});

// ====== COMBO BOXES ======
function initCombo(inputId, dropdownId, presets) {
  const input = document.getElementById(inputId);
  const dropdown = document.getElementById(dropdownId);
  function render(filter = '') {
    const q = filter.toLowerCase();
    const filtered = presets.filter(v => v.toLowerCase().includes(q));
    dropdown.innerHTML = filtered.map(v => `<div class="combo-option">${v}</div>`).join('');
    dropdown.classList.toggle('show', filtered.length > 0);
    dropdown.querySelectorAll('.combo-option').forEach(opt => {
      opt.addEventListener('mousedown', e => { e.preventDefault(); input.value = opt.textContent; dropdown.classList.remove('show'); });
    });
  }
  input.addEventListener('focus', () => render(input.value));
  input.addEventListener('input', () => render(input.value));
  input.addEventListener('keydown', e => { if (e.key === 'Escape' || e.key === 'Enter') dropdown.classList.remove('show'); });
}
initCombo('el', 'el_dropdown', EL_PRESETS);
initCombo('sec', 'sec_dropdown', SEC_PRESETS);
document.addEventListener('click', e => { if (!e.target.closest('.combo-container')) $$('.combo-dropdown').forEach(d => d.classList.remove('show')); });

// ====== VALIDATION ======
function showFieldError(fieldId, msg) {
  const el = document.getElementById(fieldId);
  const err = document.getElementById('err_' + fieldId);
  if (el) el.classList.add('error');
  if (err) { err.textContent = msg; err.style.display = ''; }
}
function clearFieldError(fieldId) {
  const el = document.getElementById(fieldId);
  const err = document.getElementById('err_' + fieldId);
  if (el) el.classList.remove('error');
  if (err) { err.textContent = ''; err.style.display = 'none'; }
}
function clearAllErrors() {
  $$('.err-msg').forEach(e => { e.textContent = ''; e.style.display = 'none'; });
  $$('.error').forEach(e => e.classList.remove('error'));
}
function validate() {
  clearAllErrors();
  let valid = true;
  const baseUrl = $('#base_url').value.trim();
  if (!baseUrl) { showFieldError('url', '请输入落地页地址'); valid = false; }
  else if (!/^https?:\/\/.+/.test(baseUrl)) { showFieldError('url', 'URL 需以 http:// 或 https:// 开头'); valid = false; }
  if (!$('#source_id').value.trim()) { showFieldError('source_id', 'sourceId 为必填项'); valid = false; }
  if (!selectedPlatform) { showFieldError('platform', '请选择投放平台'); valid = false; }
  if (!$('#utm_medium').value) { showFieldError('utm_medium', '请选择投放形式'); valid = false; }
  const campaign = $('#utm_campaign').value.trim();
  if (!campaign) { showFieldError('utm_campaign', '活动名称为必填项'); valid = false; }
  else if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(campaign)) { showFieldError('utm_campaign', '请使用 kebab-case 格式'); valid = false; }
  return valid;
}

// ====== BUILD URL ======
function getSelectedMacros() {
  const cbs = document.querySelectorAll('#macro_content input[type="checkbox"]:checked');
  return Array.from(cbs).map(cb => ({ field: cb.dataset.field, template: cb.dataset.template }));
}

function buildURL(p, overrides = {}) {
  const baseUrl = overrides.base_url !== undefined ? overrides.base_url : $('#base_url').value.trim();
  const srcId = overrides.sourceId !== undefined ? overrides.sourceId : $('#source_id').value.trim();
  const el = overrides.el !== undefined ? overrides.el : $('#el').value.trim();
  const sec = overrides.sec !== undefined ? overrides.sec : $('#sec').value.trim();
  const source = p ? p.source : (overrides.utm_source || $('#utm_source').value.trim());
  const medium = overrides.utm_medium !== undefined ? overrides.utm_medium : $('#utm_medium').value;
  const campaign = overrides.utm_campaign !== undefined ? overrides.utm_campaign : $('#utm_campaign').value.trim();
  const term = overrides.utm_term !== undefined ? overrides.utm_term : $('#utm_term').value.trim();
  const content = overrides.utm_content !== undefined ? overrides.utm_content : $('#utm_content').value.trim();

  let macros;
  if (overrides.macros !== undefined) {
    macros = overrides.macros;
  } else if (overrides.fromDOM) {
    macros = getSelectedMacros();
  } else if (p && selectedPlatform && selectedPlatform.code === p.code) {
    macros = getSelectedMacros();
  } else if (p) {
    macros = p.macros.filter(m => m.default).map(m => ({ field: m.field, template: m.template }));
  } else {
    macros = [];
  }

  const separator = baseUrl.includes('?') ? '&' : '?';
  const params = [];
  if (srcId) params.push(`sourceId=${encodeURIComponent(srcId)}`);
  if (el) params.push(`el=${encodeURIComponent(el)}`);
  if (sec) params.push(`sec=${encodeURIComponent(sec)}`);
  params.push(`utm_source=${encodeURIComponent(source)}`);
  params.push(`utm_medium=${encodeURIComponent(medium)}`);
  params.push(`utm_campaign=${encodeURIComponent(campaign)}`);
  if (term) params.push(`utm_term=${encodeURIComponent(term)}`);
  if (content) params.push(`utm_content=${encodeURIComponent(content)}`);
  macros.forEach(m => params.push(`${m.field}=${m.template}`));
  return baseUrl + separator + params.join('&');
}

// ====== SINGLE GENERATE ======
$('#btn_generate').addEventListener('click', () => {
  if (!validate()) return;
  const url = buildURL(selectedPlatform, { fromDOM: true });
  $('#url_display').innerHTML = formatURL(url);
  $('#output_section_single').classList.add('show');
  $('#url_len_hint').textContent = url.length > 2000 ? `⚠ ${url.length} 字符，可能被截断` : `${url.length} 字符`;
  $('#url_len_hint').style.color = url.length > 2000 ? '#e65100' : '#999';
  $('#output_section_single').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  window._singleUrl = url;
  window._singlePlatform = selectedPlatform;
});

// ====== CLIPBOARD (with fallback for file://) ======
function copyText(text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    return navigator.clipboard.writeText(text);
  }
  // Fallback for file:// or older browsers
  return new Promise((resolve, reject) => {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed'; ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      resolve();
    } catch (e) {
      reject(e);
    }
    document.body.removeChild(ta);
  });
}

// ====== COPY & EXPORT (SINGLE) ======
$('#btn_copy').addEventListener('click', () => {
  const url = window._singleUrl || '';
  if (!url) { showToast('请先生成 URL', 'error'); return; }
  copyText(url).then(() => showToast('已复制到剪贴板', 'success')).catch(() => showToast('复制失败，请手动复制', 'error'));
});

$$('.export-single').forEach(btn => {
  btn.addEventListener('click', () => {
    const url = window._singleUrl || '';
    if (!url) { showToast('请先生成 URL', 'error'); return; }
    const fmt = btn.dataset.fmt;
    const p = window._singlePlatform || selectedPlatform;
    exportURLs([{ platform: p ? p.name : 'Unknown', url }], fmt, 'single-url');
    showToast(`已导出 ${fmt.toUpperCase()}`, 'success');
  });
});

// ====== BATCH TEMPLATES ======
const CSV_TEMPLATE_HEADER = ['platform','base_url','sourceId','el','sec','utm_medium','utm_campaign','utm_term','utm_content',...ALL_MACRO_FIELDS];

const CSV_TEMPLATE_ROWS = [
  { platform:'google', base_url:'https://lovart.ai/tools/seedance', sourceId:'910001', el:'cta_primary', sec:'hero-split', utm_medium:'cpc', utm_campaign:'seedance-2.0-launch', utm_term:'seedance_group', utm_content:'variant_a',
    campaign_id:'{campaignid}', adgroup_id:'{adgroupid}', ad_id:'{creative}', keyword:'{keyword}', device:'{device}' },
  { platform:'meta', base_url:'https://lovart.ai/tools/seedance', sourceId:'910001', el:'cta_primary', sec:'hero-split', utm_medium:'social', utm_campaign:'seedance-2.0-launch', utm_term:'', utm_content:'variant_b',
    campaign_id:'{{campaign.id}}', adgroup_id:'{{adset.id}}', ad_id:'{{ad.id}}', placement:'{{placement}}' },
  { platform:'gdt', base_url:'https://lovart.ai/tools/seedance', sourceId:'910002', el:'cta_primary', sec:'hero-split', utm_medium:'cpa', utm_campaign:'seedance-2.0-launch', utm_term:'', utm_content:'',
    campaign_id:'__CAMPAIGN_ID__', adgroup_id:'__ADGROUP_ID__', ad_id:'__CREATIVE_ID__', device:'__DEVICE_TYPE__' },
];

function buildCSVTemplate() {
  const lines = [CSV_TEMPLATE_HEADER.join(',')];
  CSV_TEMPLATE_ROWS.forEach(row => {
    const vals = CSV_TEMPLATE_HEADER.map(h => {
      const v = row[h];
      if (v === undefined || v === null) return '';
      if (v.includes(',') || v.includes('"')) return '"' + v.replace(/"/g, '""') + '"';
      return v;
    });
    lines.push(vals.join(','));
  });
  return lines.join('\n');
}

function buildJSONTemplate() {
  return JSON.stringify(CSV_TEMPLATE_ROWS.map(row => {
    const obj = {};
    CSV_TEMPLATE_HEADER.forEach(h => {
      if (row[h] !== undefined) obj[h] = row[h];
    });
    return obj;
  }), null, 2);
}

$('#btn_template_csv').addEventListener('click', () => {
  downloadText(buildCSVTemplate(), 'ad-url-template.csv', 'text/csv');
  showToast('CSV 模板已下载', 'success');
});
$('#btn_template_json').addEventListener('click', () => {
  downloadText(buildJSONTemplate(), 'ad-url-template.json', 'application/json');
  showToast('JSON 模板已下载', 'success');
});

$('#file_upload').addEventListener('change', e => {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => { $('#batch_input').value = reader.result; };
  reader.readAsText(file);
});

// ====== CSV PARSING ======
function parseCSVLine(line) {
  const result = []; let current = '', inQuotes = false;
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (inQuotes) {
      if (ch === '"') { if (line[i + 1] === '"') { current += '"'; i++; } else inQuotes = false; }
      else current += ch;
    } else {
      if (ch === '"') inQuotes = true;
      else if (ch === ',') { result.push(current); current = ''; }
      else current += ch;
    }
  }
  result.push(current);
  return result;
}

function parseCSV(text) {
  const lines = text.trim().split(/\r?\n/);
  if (lines.length < 2) throw new Error('CSV 至少需要表头 + 1 行数据');
  const headers = lines[0].split(',').map(h => h.trim().toLowerCase());
  const required = ['platform', 'base_url', 'sourceid', 'utm_medium', 'utm_campaign'];
  const missing = required.filter(r => !headers.includes(r));
  if (missing.length > 0) throw new Error('缺少必填列: ' + missing.join(', '));
  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    const vals = parseCSVLine(lines[i]);
    if (vals.length === 0 || vals.every(v => !v.trim())) continue;
    const row = {};
    headers.forEach((h, idx) => { row[h] = (vals[idx] || '').trim(); });
    rows.push(row);
  }
  return { headers, rows };
}

function parseJSON(text) {
  const data = JSON.parse(text);
  if (!Array.isArray(data)) throw new Error('JSON 格式: 必须是数组 [{...}, {...}]');
  if (data.length === 0) throw new Error('JSON 数组不能为空');
  return data.map(item => {
    const row = {};
    Object.keys(item).forEach(k => { row[k.toLowerCase()] = String(item[k] ?? ''); });
    return row;
  });
}

// ====== BATCH PARSE & PREVIEW ======
function getRowField(row, name) {
  // Try exact match, then case-insensitive
  if (row[name] !== undefined) return row[name];
  const key = Object.keys(row).find(k => k.toLowerCase() === name.toLowerCase());
  return key ? row[key] : '';
}

$('#btn_batch_parse').addEventListener('click', () => {
  const text = $('#batch_input').value.trim();
  $('#err_batch').textContent = ''; $('#err_batch').style.display = 'none';
  if (!text) { showToast('请粘贴或上传数据', 'error'); return; }
  try {
    let rows, headers;
    if (text.startsWith('[') || text.startsWith('{')) {
      rows = parseJSON(text);
      // Collect all headers from JSON keys
      const keySet = new Set();
      rows.forEach(r => Object.keys(r).forEach(k => keySet.add(k)));
      headers = Array.from(keySet);
    } else {
      const result = parseCSV(text);
      rows = result.rows;
      headers = result.headers;
    }
    if (rows.length === 0) { showToast('未解析到任何数据行', 'error'); return; }
    batchParsedRows = rows;
    renderBatchPreview(rows, headers);
    showToast(`成功解析 ${rows.length} 行`, 'success');
  } catch (e) {
    showToast('解析失败: ' + e.message, 'error');
    $('#err_batch').textContent = '解析失败: ' + e.message; $('#err_batch').style.display = '';
  }
});

$('#btn_batch_clear').addEventListener('click', () => {
  $('#batch_input').value = '';
  $('#err_batch').textContent = ''; $('#err_batch').style.display = 'none';
  batchParsedRows = []; batchGeneratedURLs = [];
  $('#batch_preview_card').style.display = 'none';
  $('#output_section_batch').classList.remove('show');
  showToast('已清除');
});

function renderBatchPreview(rows, headers) {
  $('#batch_count').textContent = rows.length;

  // Build table headers dynamically
  const displayHeaders = ['platform','base_url','sourceid','el','sec','utm_medium','utm_campaign','utm_term','utm_content'];
  const extraHeaders = headers.filter(h => !displayHeaders.includes(h.toLowerCase()) && h.toLowerCase() !== 'status');

  const allHeaders = [...displayHeaders, ...extraHeaders, 'status'];
  $('#batch_preview_thead').innerHTML = '<tr>' + allHeaders.map(h =>
    `<th>${h.replace(/_/g, ' ')}</th>`
  ).join('') + '</tr>';

  $('#batch_preview_tbody').innerHTML = rows.map((r, i) => {
    const platformCode = getRowField(r, 'platform');
    const p = PLATFORMS.find(p => p.code === platformCode.toLowerCase());
    const errs = [];
    if (!p) errs.push('平台不识');
    if (!getRowField(r, 'base_url')) errs.push('URL缺');
    if (!getRowField(r, 'sourceid')) errs.push('sourceId缺');
    if (!getRowField(r, 'utm_medium')) { errs.push('medium缺'); }
    else if (p && !p.mediumOptions.includes(getRowField(r, 'utm_medium').toLowerCase())) {
      errs.push('medium不兼容');
    }
    if (!getRowField(r, 'utm_campaign')) errs.push('campaign缺');

    // Check macro columns: verify platform syntax
    const warnings = [];
    if (p) {
      extraHeaders.forEach(h => {
        const val = getRowField(r, h);
        if (!val) return;
        const macro = p.macros.find(m => m.field === h.toLowerCase());
        if (macro && val.trim() !== macro.template) {
          warnings.push(`${h}语法可能不匹配`);
        }
        if (!macro && val.trim()) {
          // User provided a custom macro value — that's fine
        }
      });
    }

    let status = '';
    if (errs.length > 0) {
      status = '<span class="status-err">' + errs.join(', ') + '</span>';
    } else if (warnings.length > 0) {
      status = '<span class="status-ok">OK</span> <span class="status-warn">(' + warnings.join(', ') + ')</span>';
    } else {
      status = '<span class="status-ok">OK</span>';
    }

    const cells = allHeaders.map(h => {
      const val = getRowField(r, h);
      if (h === 'status') return status;
      if (h === 'platform') return `<span class="platform-cell">${p ? p.name : (val || '-')}</span>`;
      return hd(val || '-');
    });
    return '<tr>' + cells.map(c => `<td>${c}</td>`).join('') + '</tr>';
  }).join('');

  $('#batch_preview_card').style.display = '';
  $('#output_section_batch').classList.remove('show');
}

// ====== BATCH GENERATE ======
$('#btn_batch_generate').addEventListener('click', () => {
  if (batchParsedRows.length === 0) { showToast('请先解析数据', 'error'); return; }
  batchGeneratedURLs = [];
  batchParsedRows.forEach((r, i) => {
    const platformCode = getRowField(r, 'platform');
    const p = PLATFORMS.find(p => p.code === platformCode.toLowerCase());
    if (!p) return;

    const baseUrl = getRowField(r, 'base_url');
    const srcId = getRowField(r, 'sourceid');
    const medium = getRowField(r, 'utm_medium');
    const campaign = getRowField(r, 'utm_campaign');
    if (!baseUrl || !srcId || !medium || !campaign) return;

    // Collect macros: use CSV values if present, otherwise platform defaults
    const supportedFields = new Set(p.macros.map(m => m.field));
    const macros = [];
    const usedFields = new Set();

    // First, use user-provided macro values from extra columns
    Object.keys(r).forEach(k => {
      const field = k.toLowerCase();
      if (['platform','base_url','sourceid','el','sec','utm_medium','utm_campaign','utm_term','utm_content','utm_source'].includes(field)) return;
      const val = (r[k] || '').trim();
      if (!val) return;
      // Check if this is a valid macro field for the platform or a custom field
      if (supportedFields.has(field)) {
        macros.push({ field, template: val });
        usedFields.add(field);
      } else {
        // Pass through as custom param
        macros.push({ field: k, template: val });
      }
    });

    // Fill in platform defaults for unset fields
    p.macros.forEach(m => {
      if (!usedFields.has(m.field) && m.default) {
        macros.push({ field: m.field, template: m.template });
      }
    });

    const url = buildURL(p, {
      base_url: baseUrl,
      sourceId: srcId,
      el: getRowField(r, 'el') || '',
      sec: getRowField(r, 'sec') || '',
      utm_source: p.source,
      utm_medium: medium,
      utm_campaign: campaign,
      utm_term: getRowField(r, 'utm_term') || '',
      utm_content: getRowField(r, 'utm_content') || '',
      macros,
    });
    batchGeneratedURLs.push({ platform: p.name, code: p.code, url });
  });

  $('#batch_gen_count').textContent = batchGeneratedURLs.length;
  $('#batch_gen_tbody').innerHTML = batchGeneratedURLs.map((r, i) =>
    `<tr><td>${i + 1}</td><td class="platform-cell">${r.platform}</td><td class="batch-url">${hd(r.url)}</td></tr>`
  ).join('');
  $('#output_section_batch').classList.add('show');
  $('#output_section_batch').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  showToast(`成功生成 ${batchGeneratedURLs.length} 个 URL`, 'success');
});

// ====== BATCH COPY & EXPORT ======
$('#btn_batch_copy_all').addEventListener('click', () => {
  if (batchGeneratedURLs.length === 0) { showToast('请先生成 URL', 'error'); return; }
  const text = batchGeneratedURLs.map(r => r.url).join('\n');
  copyText(text).then(() => showToast('已复制全部 URL', 'success')).catch(() => showToast('复制失败', 'error'));
});

$$('.export-batch').forEach(btn => {
  btn.addEventListener('click', () => {
    if (batchGeneratedURLs.length === 0) { showToast('请先生成 URL', 'error'); return; }
    const fmt = btn.dataset.fmt;
    exportURLs(batchGeneratedURLs, { fmt, includeFields: true }, 'ad-urls');
    showToast(`已导出 ${fmt.toUpperCase()}`, 'success');
  });
});

// ====== EXPORT ======
function exportURLs(entries, opts, basename) {
  const fmt = typeof opts === 'string' ? opts : opts.fmt;
  const includeFields = typeof opts === 'object' ? opts.includeFields : false;
  let content, mime, ext;
  switch (fmt) {
    case 'txt':
      content = entries.map(r => r.url).join('\n');
      mime = 'text/plain'; ext = 'txt'; break;
    case 'md':
      content = '# Ad URLs\n\n| # | Platform | URL |\n|---|----------|-----|\n' +
        entries.map((r, i) => `| ${i + 1} | ${r.platform} | [URL](${r.url}) |`).join('\n');
      mime = 'text/markdown'; ext = 'md'; break;
    case 'json':
      content = JSON.stringify(entries.map(r => ({ platform: r.platform, url: r.url })), null, 2);
      mime = 'application/json'; ext = 'json'; break;
    case 'csv':
      content = 'Platform,URL\n' + entries.map(r => `"${r.platform}","${r.url}"`).join('\n');
      mime = 'text/csv'; ext = 'csv'; break;
    default: return;
  }
  downloadText(content, `${basename}.${ext}`, mime);
}

function downloadText(content, filename, mime) {
  const blob = new Blob([content], { type: mime + ';charset=utf-8;' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
}

// ====== HELPERS ======
function h(str) {
  const div = document.createElement('div');
  div.textContent = String(str);
  return div.innerHTML;
}
function hd(str) { return h(str); }

function formatURL(url) {
  const idx = url.indexOf('?');
  if (idx < 0) return `<a href="${url}" target="_blank">${h(url)}</a>`;
  const base = url.substring(0, idx);
  const params = url.substring(idx + 1);
  const pairs = params.split('&');
  const lines = pairs.map(p => {
    const eq = p.indexOf('=');
    const k = eq >= 0 ? p.substring(0, eq) : p;
    const v = eq >= 0 ? p.substring(eq + 1) : '';
    return `<span style="color:#999;">${h(k)}</span>=<span style="color:#333;">${h(v)}</span>`;
  });
  return `<a href="${url}" target="_blank" style="color:#1a73e8;">${h(base)}</a>?<br>  ${lines.join('&<br>  ')}`;
}

// ====== INIT COMPLETE ======
logStatus('Ready — 请选择平台开始', '#e8f5e9');

} catch(e) {
  console.error('Ad URL Builder init error:', e);
  logStatus('Init Error: ' + e.message, '#ffebee');
}

})();
</script>
</body>
</html>
