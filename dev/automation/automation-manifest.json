{
  "primary": [
    {
      "file": ".cursor/automations/mflow-weekly-pipeline.workflow.json",
      "name": "the brand Weekly Pipeline",
      "cron": "0 7 * * 1",
      "script": "run-weekly-pipeline.sh",
      "replaces": [
        "mflow-trident-weekly",
        "mflow-tools-pull",
        "mflow-content-health-weekly",
        "mflow-seo-weekly",
        "mflow-sentinel-weekly"
      ]
    },
    {
      "file": ".cursor/automations/mflow-daily-pipeline.workflow.json",
      "name": "the brand Daily Pipeline",
      "cron": "0 8 * * *",
      "script": "run-daily-pipeline.sh",
      "replaces": ["mflow-sentinel-daily", "mflow-gsc-daily", "mflow-feishu-daily"]
    },
    {
      "file": ".cursor/automations/mflow-notion-sync-nightly.workflow.json",
      "name": "the brand Notion Sync Nightly",
      "cron": "0 21 * * *",
      "script": "notion-list-unsynced.sh"
    }
  ],
  "extended": [
    {
      "file": "automation/workflows/mflow-monthly-pipeline.workflow.json",
      "cron": "0 6 3 * *",
      "script": "run-monthly-pipeline.sh"
    },
    {
      "file": "automation/workflows/mflow-sitemap-weekly.workflow.json",
      "cron": "0 2 * * 1"
    },
    {
      "file": "automation/workflows/mflow-seo-quarterly.workflow.json",
      "cron": "0 6 5 3,6,9,12 *"
    },
    {
      "file": "automation/workflows/mflow-seo-yearly.workflow.json",
      "cron": "0 6 10 1 *"
    }
  ],
  "optional_webhooks": [
    {"file": ".cursor/automations/mflow-post-seo-content.workflow.json", "env": "MFLOW_POST_SEO_WEBHOOK"},
    {"file": ".cursor/automations/mflow-quality-gates-batch.workflow.json"}
  ],
  "legacy_individual": [
    {"file": "mflow-tools-pull.workflow.json", "saved": true, "note": "Disable if Weekly Pipeline saved"},
    {"file": "mflow-trident-weekly.workflow.json"},
    {"file": "mflow-content-health-weekly.workflow.json"},
    {"file": "mflow-seo-weekly.workflow.json"},
    {"file": "mflow-sentinel-weekly.workflow.json"},
    {"file": "mflow-sentinel-daily.workflow.json"},
    {"file": "mflow-seo-monthly.workflow.json"},
    {"file": "content-audit-monthly.workflow.json"},
    {"file": "mflow-i18n-gap-weekly.workflow.json"}
  ],
  "notion": {
    "database_url": "https://app.notion.com/p/1d50d2daf96d41b29739b67a80c0e714",
    "data_source_id": "61514ed3-39e2-4d84-b860-8334d740823e"
  },
  "post_install": [
    "Save 3 primary Automations in Cursor (Weekly, Daily, Notion Sync)",
    "Optional: Save extended workflows from automation/workflows/",
    "export MFLOW_POST_SEO_WEBHOOK=<url> after Save post-seo-content",
    "Disable duplicate Tools Pull if Weekly Pipeline is active",
    "Unload launchd: bash dev/automation/unload-all-launchd.sh",
    "Set FEISHU_WEBHOOK_URL or feishu.json",
    "Optional: MFLOW_REPORT_EMAIL"
  ]
}
