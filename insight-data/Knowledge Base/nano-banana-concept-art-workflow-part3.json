        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/f30b2cdc84a69127e78f8259f020b870d701284b136cf317b5191210e2804ab3.png", "title": "Moteur de cohérence stylistique", "description": "Nano Banana Pro et ChatCanvas travaillent ensemble pour verrouiller le style artistique sur toutes les variations de concept. Que vous ayez besoin d'une gamme de personnages cohérente, d'une esthétique d'environnement uniforme ou d'un langage d'accessoires unifié, le moteur de style garantit que chaque concept partage le même ADN visuel." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c0a7bbac9b50aa6e722a10968eb84425268fc05144d69222af892acb9b1d5932.png", "title": "Touch Edit sémantique pour concepts", "description": "Affinez votre concept art avec précision grâce à Touch Edit. Modifiez des éléments spécifiques — costume de personnage, éclairage d'environnement, matériaux d'accessoires — tout en maintenant la cohérence artistique avec la composition environnante. Aucun masquage manuel ni repeinture requis." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/09928fa343e91c59008a2e00c6528969f41fb1559d444c633e46c9da63d11dd6.png", "title": "Éditeur d'annotations", "description": "Ajoutez des annotations prêtes pour la production, des légendes de matériaux, des références d'échelle et des notes de design directement sur votre concept art avec Text Edit. Contrairement aux outils traditionnels nécessitant des calques d'annotation séparés, Lovart restitue un texte d'annotation propre et lisible." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/a605b61b07e767af7c70d858c27756f7e15f56b99a389980fba298cba1b8ffa7.png", "title": "Export 8K prêt pour la production", "description": "Exportez du concept art jusqu'à une résolution 8K en PNG, JPG, SVG ou PSD avec calques. Parfait pour la transmission en production aux modeleurs 3D, artistes d'environnement et directeurs créatifs. Chaque export maintient la qualité visuelle attendue pour la production de jeux, films et animations." },
        { "icon_url": "https://assets-persist.lovart.ai/web/model/28e251feadfb49ba8a81eb86bd81f2e2/c7f26357d97de99927ed994806f34aa7110314fc4ac8204733bb8339825cb166.png", "title": "Pipeline concept-à-présentation", "description": "Transformez les explorations de concepts brutes en présentations soignées prêtes pour le client. Générez des fiches de concept multi-vues, des comparaisons de style avec annotations et des présentations contextuelles via Smart Mockup — montrant les personnages en scène et les environnements avec référence d'échelle." }
